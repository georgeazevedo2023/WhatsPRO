<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- ================================================================
         VISIBILIDADE DE PACOTES (Android 11+ / targetSdk 35)
         Lição de campo do Casa do Agricultor (2026-08-03): SEM este bloco a
         câmera NÃO ABRE em parte dos aparelhos. O Capacitor
         (BridgeWebChromeClient.showImageCapturePicker) faz
         resolveActivity(IMAGE_CAPTURE) — e com targetSdk 35 o Android FILTRA
         o que o resolve enxerga: sem declarar a intent aqui o app de câmera
         fica invisível, o resolve devolve null e o usuário cai no seletor de
         arquivos ("só as fotos que você selecionar"). ROM que libera o próprio
         app de câmera mascarava o bug: um celular funcionava, outro não, com
         o MESMO APK. Declarar é aditivo. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- câmera: <input type="file"> do ChatInput abre o chooser nativo
         (Câmera | Galeria | Arquivos); o WebView pede permissão na 1ª vez -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- nota de voz: getUserMedia + MediaRecorder (useAudioRecorder.ts, mesmo
         caminho OGG/Opus do navegador — formato já provado com a UAZAPI) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- push "cliente esperando" (fase 3; Android 13+ exige pedir em runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- celular sem câmera ainda pode instalar (só perde o atalho de foto) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
